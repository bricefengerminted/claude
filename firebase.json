{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
          { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/anthropic",
        "function": {
          "functionId": "anthropicProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/anthropic/**",
        "function": {
          "functionId": "anthropicProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
